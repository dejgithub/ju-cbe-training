# ------------------------------------------------------------
# Copy to .env for local use. On Vercel, add the same names under
# Project > Settings > Environment Variables (do NOT upload .env).
# ------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
SESSION_MAX_AGE_HOURS=8

# Database (local XAMPP defaults; on Vercel use your hosted MySQL values)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ju_cbe_training

# Hosted MySQL (Aiven, TiDB Cloud, Railway ...) normally requires SSL
DB_SSL=false
# Set to true only if the host does not allow CREATE DATABASE
DB_SKIP_CREATE=false

# File uploads. Leave UPLOAD_STORAGE empty: "disk" locally, "db" on Vercel.
# Vercel limits uploads to about 4.5 MB.
UPLOAD_MAX_SIZE_MB=4
UPLOAD_STORAGE=

# Default password for newly created user accounts
DEFAULT_USER_PASSWORD=Password@123
