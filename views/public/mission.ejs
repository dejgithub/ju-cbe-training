<section class="public-page-header">
  <div class="container">
    <h1 class="fw-bold mb-1">Our Mission</h1>
    <p class="text-white-50 mb-0">Why the CBE Training Management System exists</p>
  </div>
</section>

<section class="container py-5">
  <div class="row g-4">
    <div class="col-lg-8">
      <div class="card mb-3">
        <div class="card-body p-4">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="stat-icon bg-ju-soft text-ju"><i class="bi bi-bullseye"></i></div>
            <h2 class="h5 fw-bold mb-0">Mission statement</h2>
          </div>
          <p class="text-muted mb-0">
            Our mission is to support <%= institutionName %> in delivering high-quality Community-Based Education by
            providing a reliable, transparent, and easy-to-use platform that coordinates students, instructors, and
            community partners — enabling meaningful service-learning, accurate records, timely supervision, and fair,
            competency-based assessment for every student.
          </p>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="card h-100"><div class="card-body">
            <h3 class="h6 fw-bold"><i class="bi bi-1-circle text-ju me-2"></i>Enable learning in the community</h3>
            <p class="text-muted small mb-0">Make it easy to plan, place, and supervise students at community sites so that learning happens where it matters most.</p>
          </div></div>
        </div>
        <div class="col-md-6">
          <div class="card h-100"><div class="card-body">
            <h3 class="h6 fw-bold"><i class="bi bi-2-circle text-ju me-2"></i>Ensure accuracy &amp; transparency</h3>
            <p class="text-muted small mb-0">Keep consistent, auditable records of placements, attendance, reports, and results for all stakeholders.</p>
          </div></div>
        </div>
        <div class="col-md-6">
          <div class="card h-100"><div class="card-body">
            <h3 class="h6 fw-bold"><i class="bi bi-3-circle text-ju me-2"></i>Support fair assessment</h3>
            <p class="text-muted small mb-0">Standardize competency assessment with configurable criteria and clear, timely feedback to students.</p>
          </div></div>
        </div>
        <div class="col-md-6">
          <div class="card h-100"><div class="card-body">
            <h3 class="h6 fw-bold"><i class="bi bi-4-circle text-ju me-2"></i>Strengthen partnerships</h3>
            <p class="text-muted small mb-0">Give community partners a simple way to participate through confirmations and feedback.</p>
          </div></div>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-header"><i class="bi bi-star me-1 text-ju"></i> Core values</div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item"><i class="bi bi-patch-check text-success me-2"></i>Quality &amp; academic excellence</li>
          <li class="list-group-item"><i class="bi bi-people text-success me-2"></i>Community engagement &amp; service</li>
          <li class="list-group-item"><i class="bi bi-shield-check text-success me-2"></i>Integrity &amp; accountability</li>
          <li class="list-group-item"><i class="bi bi-lightbulb text-success me-2"></i>Innovation &amp; continuous improvement</li>
          <li class="list-group-item"><i class="bi bi-gender-ambiguous text-success me-2"></i>Inclusiveness &amp; respect</li>
        </ul>
      </div>
    </div>
  </div>
</section>
