<section class="public-page-header">
  <div class="container">
    <h1 class="fw-bold mb-1">About</h1>
    <p class="text-white-50 mb-0">Community-Based Education at <%= institutionName %></p>
  </div>
</section>

<section class="container py-5">
  <div class="row g-4">
    <div class="col-lg-7">
      <div class="card mb-3">
        <div class="card-body p-4">
          <h2 class="h5 fw-bold mb-3"><i class="bi bi-info-circle text-ju me-2"></i>What is Community-Based Education?</h2>
          <p class="text-muted">
            Community-Based Education (CBE) is a training approach in which students learn by working directly with
            communities. Under supervision, students are placed at community sites — health centers, schools, kebeles,
            NGOs, and government offices — where they apply their knowledge to real community needs while developing
            professional and social competencies.
          </p>
          <p class="text-muted mb-0">
            CBE strengthens the link between the university and the community, promotes service-learning, and prepares
            graduates who understand and respond to the priority problems of the communities they serve.
          </p>
        </div>
      </div>

      <div class="card">
        <div class="card-body p-4">
          <h2 class="h5 fw-bold mb-3"><i class="bi bi-app-indicator text-ju me-2"></i>About this system</h2>
          <p class="text-muted">
            The CBE Training Management System is a web-based platform developed for <%= institutionName %> to
            digitize and coordinate the entire CBE workflow. It brings together program planning, student records,
            community sites and partners, placements, attendance, fieldwork reporting, competency assessment, and
            analytics in a single, role-based application.
          </p>
          <p class="text-muted mb-0">
            The system serves five user groups — Administrators, Coordinators, Instructors, Students, and Community
            Partners — each with a tailored workspace, so everyone sees exactly what they need.
          </p>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card mb-3">
        <div class="card-header"><i class="bi bi-people me-1 text-ju"></i> Who uses the system</div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex gap-3"><i class="bi bi-shield-lock text-ju"></i><div><strong>Administrators</strong><div class="text-muted small">Manage users, departments, years, groups, settings and audit logs.</div></div></li>
          <li class="list-group-item d-flex gap-3"><i class="bi bi-diagram-3 text-ju"></i><div><strong>Coordinators</strong><div class="text-muted small">Plan programs, coordinate placements, and monitor performance.</div></div></li>
          <li class="list-group-item d-flex gap-3"><i class="bi bi-person-badge text-ju"></i><div><strong>Instructors</strong><div class="text-muted small">Supervise students, record attendance, review reports, and assess.</div></div></li>
          <li class="list-group-item d-flex gap-3"><i class="bi bi-mortarboard text-ju"></i><div><strong>Students</strong><div class="text-muted small">View placements, submit reports, and track attendance and results.</div></div></li>
          <li class="list-group-item d-flex gap-3"><i class="bi bi-building text-ju"></i><div><strong>Community partners</strong><div class="text-muted small">Confirm participation and provide feedback on assigned students.</div></div></li>
        </ul>
      </div>
      <div class="card">
        <div class="card-header"><i class="bi bi-list-check me-1 text-ju"></i> Key features</div>
        <ul class="list-group list-group-flush small">
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Student registration &amp; CSV import</li>
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Community sites &amp; partner management</li>
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Placements &amp; supervision</li>
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Attendance &amp; session tracking</li>
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Fieldwork report review workflow</li>
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Weighted competency assessment</li>
          <li class="list-group-item"><i class="bi bi-check2 text-success me-1"></i> Notifications, announcements &amp; analytics</li>
        </ul>
      </div>
    </div>
  </div>
</section>
