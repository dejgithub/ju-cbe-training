<section class="public-hero">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <img src="/img/ju-logo.jpg" alt="<%= institutionName %> logo" class="public-hero-logo mb-3">
        <h1 class="display-6 fw-bold mb-3">Community-Based Education Training Management System</h1>
        <p class="lead mb-4">
          A single platform for <%= institutionName %> to plan CBE programs, place students in the community,
          track attendance and fieldwork, assess competencies, and measure impact.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a href="/login" class="btn btn-light btn-lg text-ju fw-semibold"><i class="bi bi-box-arrow-in-right me-1"></i> Sign in</a>
          <a href="/about" class="btn btn-outline-light btn-lg"><i class="bi bi-info-circle me-1"></i> Learn more</a>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="public-hero-card">
          <div class="row g-3 text-center">
            <div class="col-6"><div class="public-hero-stat"><i class="bi bi-people"></i><span>Students</span></div></div>
            <div class="col-6"><div class="public-hero-stat"><i class="bi bi-geo-alt"></i><span>Placements</span></div></div>
            <div class="col-6"><div class="public-hero-stat"><i class="bi bi-calendar-check"></i><span>Attendance</span></div></div>
            <div class="col-6"><div class="public-hero-stat"><i class="bi bi-clipboard-check"></i><span>Assessments</span></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container py-5">
  <div class="text-center mb-4">
    <span class="badge bg-ju-soft text-ju mb-2">What you can do</span>
    <h2 class="h3 fw-bold mb-0">Everything CBE in one place</h2>
  </div>
  <div class="row g-4">
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 public-feature">
        <div class="card-body">
          <div class="stat-icon bg-ju-soft text-ju mb-3"><i class="bi bi-people"></i></div>
          <h3 class="h6 fw-bold">Student management</h3>
          <p class="text-muted small mb-0">Register students, import records in bulk, and keep a complete history of each learner's CBE journey.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 public-feature">
        <div class="card-body">
          <div class="stat-icon bg-ju-soft text-ju mb-3"><i class="bi bi-geo-alt"></i></div>
          <h3 class="h6 fw-bold">Community placements</h3>
          <p class="text-muted small mb-0">Assign students and groups to community sites with supervisors, and manage placements end to end.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 public-feature">
        <div class="card-body">
          <div class="stat-icon bg-ju-soft text-ju mb-3"><i class="bi bi-calendar-check"></i></div>
          <h3 class="h6 fw-bold">Attendance tracking</h3>
          <p class="text-muted small mb-0">Record daily attendance and sessions, and view per-student and program-wide statistics.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 public-feature">
        <div class="card-body">
          <div class="stat-icon bg-ju-soft text-ju mb-3"><i class="bi bi-file-earmark-text"></i></div>
          <h3 class="h6 fw-bold">Fieldwork reports</h3>
          <p class="text-muted small mb-0">Students submit field reports; instructors review, approve, or return them with feedback.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 public-feature">
        <div class="card-body">
          <div class="stat-icon bg-ju-soft text-ju mb-3"><i class="bi bi-clipboard-check"></i></div>
          <h3 class="h6 fw-bold">Competency assessments</h3>
          <p class="text-muted small mb-0">Score students against weighted criteria, compute grades automatically, and release results.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 public-feature">
        <div class="card-body">
          <div class="stat-icon bg-ju-soft text-ju mb-3"><i class="bi bi-graph-up"></i></div>
          <h3 class="h6 fw-bold">Reports &amp; analytics</h3>
          <p class="text-muted small mb-0">Track registration, placement, attendance, assessment, and completion trends with exportable reports.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="public-cta">
  <div class="container text-center py-5">
    <h2 class="h3 fw-bold text-white mb-2">Ready to get started?</h2>
    <p class="text-white-50 mb-4">Sign in with your university account to access your CBE dashboard.</p>
    <a href="/login" class="btn btn-light btn-lg text-ju fw-semibold"><i class="bi bi-box-arrow-in-right me-1"></i> Sign in to the system</a>
  </div>
</section>
