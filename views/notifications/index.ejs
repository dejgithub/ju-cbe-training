<%
  const typeClass = { Info: 'text-primary', Success: 'text-success', Warning: 'text-warning', Danger: 'text-danger', Announcement: 'text-ju' };
%>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">Notifications</h2>
    <p class="text-muted small mb-0">Your alerts, reminders and announcements.</p>
  </div>
  <form method="post" action="/notifications/read-all">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn-outline-ju btn-sm"><i class="bi bi-check2-all me-1"></i> Mark all as read</button>
  </form>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><i class="bi bi-bell me-1 text-ju"></i> Notifications</div>
      <div class="list-group list-group-flush">
        <% if (notifications.length === 0) { %><div class="list-group-item text-muted text-center py-4">No notifications.</div><% } %>
        <% notifications.forEach(function (n) { %>
          <form method="post" action="/notifications/<%= n.id %>/read">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (n.link) { %><input type="hidden" name="link" value="<%= n.link %>"><% } %>
            <button type="submit" class="list-group-item list-group-item-action d-flex gap-3 <%= n.is_read ? '' : 'bg-light' %>">
              <div class="flex-shrink-0"><i class="bi bi-circle-fill <%= typeClass[n.type] || 'text-secondary' %>" style="font-size:.6rem"></i></div>
              <div class="flex-grow-1 text-start">
                <div class="d-flex justify-content-between">
                  <span class="fw-semibold small"><%= n.title %></span>
                  <span class="text-muted" style="font-size:.72rem"><%= formatDateTime(n.created_at) %></span>
                </div>
                <div class="text-muted small"><%= n.message %></div>
                <div class="mt-1"><span class="badge bg-light text-dark border"><%= n.type %></span> <% if (!n.is_read) { %><span class="badge bg-primary">New</span><% } %></div>
              </div>
            </button>
          </form>
        <% }); %>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header"><i class="bi bi-megaphone me-1 text-ju"></i> Announcements</div>
      <div class="card-body">
        <% if (announcements.length === 0) { %><p class="text-muted small mb-0">No announcements at this time.</p><% } %>
        <% announcements.forEach(function (a) { %>
          <div class="border-bottom pb-2 mb-2">
            <div class="d-flex justify-content-between">
              <span class="fw-semibold small"><%= a.title %></span>
              <span class="text-muted" style="font-size:.72rem"><%= formatDateTime(a.created_at) %></span>
            </div>
            <div class="small text-muted"><%= a.message %></div>
            <span class="badge bg-light text-dark border mt-1"><%= a.audience %></span>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>