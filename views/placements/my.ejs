<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">My placement</h2>
    <p class="text-muted small mb-0">Your community-based education placement details.</p>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body d-flex flex-wrap gap-3 align-items-center">
    <div class="avatar-circle"><%= (student.full_name || '?').charAt(0).toUpperCase() %></div>
    <div>
      <div class="fw-semibold"><%= student.full_name %></div>
      <div class="text-muted small">
        <span class="font-monospace"><%= student.student_id %></span>
        <% if (student.department_name) { %> &middot; <%= student.department_name %><% } %>
        <% if (student.group_name) { %> &middot; <%= student.group_name %><% } %>
      </div>
    </div>
  </div>
</div>

<% if (placements.length === 0) { %>
  <div class="card">
    <div class="card-body">
      <div class="empty-state">
        <i class="bi bi-geo-alt"></i>
        You have not been assigned to a community site yet. Your coordinator will notify you once a placement is created.
      </div>
    </div>
  </div>
<% } %>

<% placements.forEach(function (p) { %>
  <div class="card mb-3">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
      <span><i class="bi bi-geo-alt me-1 text-ju"></i> <span class="fw-semibold"><%= p.program_name %></span> <span class="text-muted small">(<%= p.program_code %>)</span></span>
      <span class="badge <%= statusBadgeClass(p.status) %>"><%= p.status %></span>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-12 col-md-6">
          <div class="text-muted small text-uppercase">Community site</div>
          <div class="fw-semibold"><%= p.site_name || '-' %></div>
          <% if (p.site_type) { %><span class="badge bg-ju-soft text-ju"><%= p.site_type %></span><% } %>
          <% if (p.site_address || p.site_city) { %>
            <div class="text-muted small mt-1">
              <i class="bi bi-geo-alt me-1"></i><%= [p.site_address, p.site_city].filter(Boolean).join(', ') %>
            </div>
          <% } %>
        </div>
        <div class="col-12 col-md-6">
          <div class="text-muted small text-uppercase">Supervisor</div>
          <div class="fw-semibold"><%= p.supervisor_name || 'Unassigned' %></div>
          <% if (p.group_name) { %><div class="text-muted small mt-1"><i class="bi bi-people me-1"></i>Group: <%= p.group_name %></div><% } %>
        </div>
        <div class="col-12 col-md-6">
          <div class="text-muted small text-uppercase">Placement period</div>
          <div><%= formatDate(p.start_date) %> &ndash; <%= formatDate(p.end_date) %></div>
        </div>
        <div class="col-12 col-md-6">
          <div class="text-muted small text-uppercase">Program period</div>
          <div><%= formatDate(p.program_start) %> &ndash; <%= formatDate(p.program_end) %></div>
        </div>
        <% if (p.contact_person || p.site_phone || p.site_email) { %>
          <div class="col-12">
            <div class="text-muted small text-uppercase">Site contact</div>
            <div class="d-flex flex-wrap gap-3">
              <% if (p.contact_person) { %><span><i class="bi bi-person me-1 text-muted"></i><%= p.contact_person %></span><% } %>
              <% if (p.site_phone) { %><span><i class="bi bi-telephone me-1 text-muted"></i><%= p.site_phone %></span><% } %>
              <% if (p.site_email) { %><span><i class="bi bi-envelope me-1 text-muted"></i><%= p.site_email %></span><% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
<% }); %>
