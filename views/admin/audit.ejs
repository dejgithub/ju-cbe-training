<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0">Audit logs</h2>
    <p class="text-muted small mb-0">Most recent <%= logs.length %> system activities.</p>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-shield-check me-1 text-ju"></i> Activity log</span>
    <input type="text" class="form-control form-control-sm w-auto" placeholder="Filter table..." data-table-filter="#auditTable">
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="auditTable">
      <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>Details</th><th>IP</th></tr></thead>
      <tbody>
        <% if (logs.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No activity recorded.</td></tr><% } %>
        <% logs.forEach(function (l) { %>
          <tr>
            <td class="small text-muted text-nowrap"><%= formatDateTime(l.created_at) %></td>
            <td class="small"><%= l.user_name || 'System' %></td>
            <td><span class="badge bg-light text-dark border"><%= l.action %></span></td>
            <td class="small text-muted"><%= l.entity_type || '-' %><%= l.entity_id ? ' #' + l.entity_id : '' %></td>
            <td class="small text-muted" style="max-width:320px"><%= l.details || '-' %></td>
            <td class="small text-muted font-monospace"><%= l.ip_address || '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>