<%
  const audiences = ['All', 'Students', 'Instructors', 'Coordinators', 'Admin', 'Partners'];
%>
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0">Announcements</h2>
    <p class="text-muted small mb-0"><%= announcements.length %> announcement(s)</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><i class="bi bi-megaphone me-1 text-ju"></i> Published announcements</div>
      <div class="card-body">
        <% if (announcements.length === 0) { %><p class="text-muted small mb-0">No announcements yet.</p><% } %>
        <% announcements.forEach(function (a) { %>
          <div class="border rounded p-3 mb-3">
            <form method="post" action="/admin/announcements/<%= a.id %>" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="col-md-8"><label class="form-label small">Title</label><input type="text" name="title" class="form-control form-control-sm" value="<%= a.title %>" required></div>
              <div class="col-md-4"><label class="form-label small">Audience</label>
                <select name="audience" class="form-select form-select-sm">
                  <% audiences.forEach(function (au) { %><option value="<%= au %>" <%= a.audience === au ? 'selected' : '' %>><%= au %></option><% }); %>
                </select>
              </div>
              <div class="col-12"><label class="form-label small">Message</label><textarea name="message" class="form-control form-control-sm" rows="2" required><%= a.message %></textarea></div>
              <div class="col-12 d-flex justify-content-between align-items-center">
                <div class="form-check"><input type="checkbox" name="is_active" value="1" class="form-check-input" id="active_<%= a.id %>" <%= a.is_active ? 'checked' : '' %>><label class="form-check-label small" for="active_<%= a.id %>">Active</label></div>
                <div class="small text-muted">By <%= a.author_name %> on <%= formatDate(a.created_at) %></div>
              </div>
              <div class="col-12 d-flex gap-2">
                <button class="btn btn-sm btn-ju"><i class="bi bi-save me-1"></i> Save</button>
              </div>
            </form>
            <form method="post" action="/admin/announcements/<%= a.id %>/delete" class="mt-2 text-end" data-confirm="Delete this announcement?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</button>
            </form>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header"><i class="bi bi-send-plus me-1 text-ju"></i> New announcement</div>
      <div class="card-body">
        <form method="post" action="/admin/announcements" class="row g-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-12"><label class="form-label small">Title</label><input type="text" name="title" class="form-control form-control-sm" required maxlength="200"></div>
          <div class="col-12"><label class="form-label small">Audience</label>
            <select name="audience" class="form-select form-select-sm"><% audiences.forEach(function (au) { %><option value="<%= au %>"><%= au %></option><% }); %></select>
          </div>
          <div class="col-12"><label class="form-label small">Message</label><textarea name="message" class="form-control form-control-sm" rows="3" required></textarea></div>
          <div class="col-12 form-check ms-1"><input type="checkbox" name="is_active" value="1" class="form-check-input" id="new_active" checked><label class="form-check-label small" for="new_active">Publish immediately (also sends a notification)</label></div>
          <div class="col-12"><button class="btn btn-ju btn-sm"><i class="bi bi-megaphone me-1"></i> Publish</button></div>
        </form>
      </div>
    </div>
  </div>
</div>