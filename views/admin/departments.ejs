<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0">Departments</h2>
    <p class="text-muted small mb-0"><%= departments.length %> department(s)</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header"><i class="bi bi-diagram-3 me-1 text-ju"></i> Departments</div>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Name</th><th>Code</th><th class="text-end">Students</th><th class="text-end">Programs</th><th class="text-end">Actions</th></tr></thead>
          <tbody>
            <% departments.forEach(function (d) { %>
              <tr>
                <td colspan="5" class="p-0">
                  <form method="post" action="/admin/departments/<%= d.id %>" class="row g-2 align-items-center m-0 p-2 border-bottom">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-4"><input type="text" name="name" class="form-control form-control-sm" value="<%= d.name %>" required></div>
                    <div class="col-md-3"><input type="text" name="code" class="form-control form-control-sm" value="<%= d.code %>" required></div>
                    <div class="col-md-2 text-end"><%= d.student_count %></div>
                    <div class="col-md-2 text-end"><%= d.program_count %></div>
                    <div class="col-md-1 text-end"><button class="btn btn-sm btn-outline-primary"><i class="bi bi-save"></i></button></div>
                  </form>
                  <form method="post" action="/admin/departments/<%= d.id %>/delete" class="px-2 pb-2 text-end" data-confirm="Delete department <%= d.name %>?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash me-1"></i> Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header"><i class="bi bi-plus-circle me-1 text-ju"></i> Add department</div>
      <div class="card-body">
        <form method="post" action="/admin/departments" class="row g-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-12"><label class="form-label small">Name</label><input type="text" name="name" class="form-control form-control-sm" required maxlength="150"></div>
          <div class="col-12"><label class="form-label small">Code</label><input type="text" name="code" class="form-control form-control-sm" required maxlength="20" placeholder="e.g. PH"></div>
          <div class="col-12"><label class="form-label small">Description</label><input type="text" name="description" class="form-control form-control-sm"></div>
          <div class="col-12"><button class="btn btn-ju btn-sm"><i class="bi bi-plus-lg me-1"></i> Add department</button></div>
        </form>
      </div>
    </div>
  </div>
</div>