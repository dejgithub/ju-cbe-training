<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">Assigned students</h2>
    <p class="text-muted small mb-0"><%= partner.organization_name %></p>
  </div>
</div>

<div class="row g-3 mb-1">
  <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-icon bg-ju-soft text-ju"><i class="bi bi-people"></i></div><div><div class="stat-value"><%= placements.length %></div><div class="stat-label">Assigned students</div></div></div></div>
  <div class="col-6 col-md-3"><div class="stat-card"><div class="stat-icon bg-ju-soft text-ju"><i class="bi bi-geo-alt"></i></div><div><div class="stat-value"><%= sites.length %></div><div class="stat-label">Community sites</div></div></div></div>
</div>

<% if (sites.length) { %>
  <div class="card mb-3">
    <div class="card-header"><i class="bi bi-geo-alt me-1 text-ju"></i> Our community sites</div>
    <div class="card-body">
      <div class="d-flex flex-wrap gap-2">
        <% sites.forEach(function (s) { %>
          <span class="badge bg-light text-dark border"><i class="bi bi-pin-map me-1"></i><%= s.name %><% if (s.site_type) { %> · <%= s.site_type %><% } %></span>
        <% }); %>
      </div>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-person-check me-1 text-ju"></i> Students placed with us</span>
    <span class="badge bg-secondary"><%= placements.length %></span>
  </div>
  <div class="card-body">
    <% if (placements.length === 0) { %>
      <div class="empty-state"><i class="bi bi-person-check"></i>No students have been placed with your organization yet.</div>
    <% } %>
    <% placements.forEach(function (p) {
         const confirmation = confirmationByPlacement.get(p.id);
         const fbs = feedbackByPlacement.get(p.id) || [];
    %>
      <div class="border rounded p-3 mb-3">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
          <div>
            <div class="fw-semibold"><%= p.student_name %> <span class="text-muted small font-monospace">(<%= p.reg_no %>)</span></div>
            <div class="small text-muted"><%= p.program_name %> · <%= p.department_name || '—' %> · <%= p.site_name %></div>
            <div class="small text-muted">Placement: <%= p.start_date ? formatDate(p.start_date) : '—' %> – <%= p.end_date ? formatDate(p.end_date) : '—' %></div>
          </div>
          <div class="text-end">
            <span class="badge <%= statusBadgeClass(p.placement_status) %>"><%= p.placement_status %></span>
            <% if (confirmation) { %>
              <div class="mt-1"><span class="badge <%= confirmation.status === 'Confirmed' ? 'bg-success' : 'bg-danger' %>">Participation <%= confirmation.status %></span></div>
            <% } %>
          </div>
        </div>

        <div class="row g-2 mt-2">
          <div class="col-md-6">
            <form method="post" action="/partner/confirm" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="placement_id" value="<%= p.id %>">
              <div class="col-12"><label class="form-label small mb-0">Confirm participation</label></div>
              <div class="col-6">
                <select name="status" class="form-select form-select-sm">
                  <option value="Confirmed" <%= confirmation && confirmation.status === 'Confirmed' ? 'selected' : '' %>>Confirmed</option>
                  <option value="Declined" <%= confirmation && confirmation.status === 'Declined' ? 'selected' : '' %>>Declined</option>
                </select>
              </div>
              <div class="col-6"><input type="text" name="note" class="form-control form-control-sm" placeholder="Note (optional)"></div>
              <div class="col-12"><button class="btn btn-ju btn-sm"><i class="bi bi-check2-circle me-1"></i> Record</button></div>
            </form>
          </div>
          <div class="col-md-6">
            <form method="post" action="/partner/feedback" class="row g-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="placement_id" value="<%= p.id %>">
              <div class="col-12"><label class="form-label small mb-0">Submit feedback</label></div>
              <div class="col-4">
                <select name="rating" class="form-select form-select-sm">
                  <% [5,4,3,2,1].forEach(function (r) { %><option value="<%= r %>"><%= r %> ★</option><% }); %>
                </select>
              </div>
              <div class="col-8"><input type="text" name="comment" class="form-control form-control-sm" placeholder="Comment" required></div>
              <div class="col-12"><button class="btn btn-outline-ju btn-sm"><i class="bi bi-chat-dots me-1"></i> Send feedback</button></div>
            </form>
          </div>
        </div>

        <% if (fbs.length) { %>
          <div class="mt-3 border-top pt-2">
            <div class="small text-muted mb-1">Previous feedback</div>
            <% fbs.forEach(function (f) { %>
              <div class="small mb-1"><i class="bi bi-star-fill text-warning"></i> <%= f.rating ? f.rating + '/5' : '—' %> — <%= f.comment %> <span class="text-muted">(<%= f.author %>, <%= formatDate(f.created_at) %>)</span></div>
            <% }); %>
          </div>
        <% } %>
      </div>
    <% }); %>
  </div>
</div>