<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0">My fieldwork reports</h2>
    <p class="text-muted small mb-0">Submit and track your CBE fieldwork reports.</p>
  </div>
  <a href="/reports/new" class="btn btn-ju btn-sm"><i class="bi bi-plus-lg me-1"></i> Submit report</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" data-sortable>
      <thead><tr><th class="sortable">Title</th><th>Program</th><th class="sortable">Submitted</th><th>Status</th><th>Reviewed</th><th class="text-end">Actions</th></tr></thead>
      <tbody>
        <% if (reports.length === 0) { %><tr><td colspan="6"><div class="empty-state"><i class="bi bi-file-earmark-text"></i>You have not submitted any reports yet.</div></td></tr><% } %>
        <% reports.forEach(function (r) { %>
          <tr>
            <td><a href="/reports/<%= r.id %>" class="fw-semibold"><%= r.title %></a></td>
            <td class="small text-muted"><%= r.program_name %></td>
            <td class="small text-muted"><%= formatDateTime(r.submitted_at) %></td>
            <td><span class="badge <%= statusBadgeClass(r.status) %>"><%= r.status %></span></td>
            <td class="small text-muted"><%= r.reviewed_at ? formatDateTime(r.reviewed_at) : '-' %></td>
            <td class="text-end">
              <a href="/reports/<%= r.id %>" class="btn btn-sm btn-outline-ju"><i class="bi bi-eye"></i></a>
              <a href="/reports/<%= r.id %>/download" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i></a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>