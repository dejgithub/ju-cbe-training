<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">Fieldwork report submissions</h2>
    <p class="text-muted small mb-0"><%= rows.length %> submission(s)</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/analytics/fieldwork.csv<%= toQuery(filters) ? '?' + toQuery(filters) : '' %>" class="btn btn-ju btn-sm"><i class="bi bi-download me-1"></i> Download CSV</a>
    <a href="/analytics" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Analytics</a>
  </div>
</div>

<%- include('_filters', { options, filters, action: '/analytics/fieldwork', withStatus: true, statusOptions: ['Submitted','Under Review','Approved','Returned'] }) %>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" data-sortable>
      <thead><tr><th>Student ID</th><th class="sortable">Student</th><th>Program</th><th>Title</th><th>Status</th><th>Submitted</th><th>Reviewed</th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-4">No submissions found.</td></tr><% } %>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="font-monospace small"><%= r.student_id %></td>
            <td class="fw-semibold"><%= r.student_name %></td>
            <td class="small text-muted"><%= r.program_name %></td>
            <td><a href="/reports/<%= r.id %>"><%= r.title %></a></td>
            <td><span class="badge <%= statusBadgeClass(r.status) %>"><%= r.status %></span></td>
            <td class="small text-muted"><%= formatDateTime(r.submitted_at) %></td>
            <td class="small text-muted"><%= r.reviewed_at ? formatDateTime(r.reviewed_at) : '-' %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>