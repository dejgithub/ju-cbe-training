<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">Student registration report</h2>
    <p class="text-muted small mb-0"><%= rows.length %> record(s)</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/analytics/students.csv<%= toQuery(filters) ? '?' + toQuery(filters) : '' %>" class="btn btn-ju btn-sm"><i class="bi bi-download me-1"></i> Download CSV</a>
    <a href="/analytics" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Analytics</a>
  </div>
</div>

<%- include('_filters', { options, filters, action: '/analytics/students', withGroup: true, withStatus: true, statusOptions: ['Enrolled','Inactive','Graduated','Transferred'] }) %>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" data-sortable>
      <thead><tr><th class="sortable">Student ID</th><th class="sortable">Full name</th><th>Gender</th><th class="sortable">Year</th><th>Department</th><th>Group</th><th>Program</th><th>Placement site</th><th>Status</th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="9" class="text-center text-muted py-4">No matching records.</td></tr><% } %>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="font-monospace small"><%= r.student_id %></td>
            <td class="fw-semibold"><%= r.full_name %></td>
            <td class="small"><%= r.gender || '-' %></td>
            <td><%= r.year_of_study %></td>
            <td class="small text-muted"><%= r.department || '-' %></td>
            <td class="small text-muted"><%= r.group || '-' %></td>
            <td class="small text-muted"><%= r.program || '-' %></td>
            <td class="small text-muted"><%= r.placement_site || '-' %></td>
            <td><span class="badge <%= statusBadgeClass(r.status) %>"><%= r.status %></span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>