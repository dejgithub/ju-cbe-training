<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">Program completion report</h2>
    <p class="text-muted small mb-0"><%= rows.length %> program(s)</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/analytics/programs.csv" class="btn btn-ju btn-sm"><i class="bi bi-download me-1"></i> Download CSV</a>
    <a href="/analytics" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Analytics</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body"><div class="stat-value"><%= completion.overall %></div><div class="stat-label">Total programs</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body"><div class="stat-value"><%= completion.active %></div><div class="stat-label">Active</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body"><div class="stat-value"><%= completion.planned %></div><div class="stat-label">Planned</div></div></div></div>
  <div class="col-6 col-md-3"><div class="card stat-card"><div class="card-body"><div class="stat-value"><%= completion.completed %></div><div class="stat-label">Completed</div></div></div></div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" data-sortable>
      <thead><tr><th>Code</th><th class="sortable">Name</th><th>Department</th><th>Status</th><th>Start</th><th>End</th><th class="sortable text-end">Students</th></tr></thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="7" class="text-center text-muted py-4">No programs found.</td></tr><% } %>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="font-monospace small"><%= r.code %></td>
            <td class="fw-semibold"><a href="/programs/<%= r.id %>"><%= r.name %></a></td>
            <td class="small text-muted"><%= r.department_name || '-' %></td>
            <td><span class="badge <%= statusBadgeClass(r.status) %>"><%= r.status %></span></td>
            <td class="small text-muted"><%= formatDate(r.start_date) %></td>
            <td class="small text-muted"><%= formatDate(r.end_date) %></td>
            <td class="text-end"><%= r.student_count %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>