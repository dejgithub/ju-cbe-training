<%
  const f = filters || {};
  const opts = options || {};
%>
<div class="card mb-3">
  <div class="card-body">
    <form class="row g-2 align-items-end" method="get" action="<%= action %>">
      <div class="col-6 col-md-3">
        <label class="form-label small">Department</label>
        <select name="departmentId" class="form-select form-select-sm">
          <option value="">All departments</option>
          <% (opts.departments || []).forEach(function (d) { %><option value="<%= d.id %>" <%= String(f.departmentId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }); %>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small">Program</label>
        <select name="programId" class="form-select form-select-sm">
          <option value="">All programs</option>
          <% (opts.programs || []).forEach(function (p) { %><option value="<%= p.id %>" <%= String(f.programId) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }); %>
        </select>
      </div>
      <div class="col-6 col-md-3">
        <label class="form-label small">Community site</label>
        <select name="siteId" class="form-select form-select-sm">
          <option value="">All sites</option>
          <% (opts.sites || []).forEach(function (s) { %><option value="<%= s.id %>" <%= String(f.siteId) === String(s.id) ? 'selected' : '' %>><%= s.name %></option><% }); %>
        </select>
      </div>
      <% if (typeof withGroup !== 'undefined' && withGroup) { %>
        <div class="col-6 col-md-3">
          <label class="form-label small">Group</label>
          <select name="groupId" class="form-select form-select-sm">
            <option value="">All groups</option>
            <% (opts.groups || []).forEach(function (g) { %><option value="<%= g.id %>" <%= String(f.groupId) === String(g.id) ? 'selected' : '' %>><%= g.name %></option><% }); %>
          </select>
        </div>
      <% } %>
      <% if (typeof withStatus !== 'undefined' && withStatus) { %>
        <div class="col-6 col-md-3">
          <label class="form-label small">Status</label>
          <select name="status" class="form-select form-select-sm">
            <option value="">All</option>
            <% (statusOptions || []).forEach(function (s) { %><option value="<%= s %>" <%= f.status === s ? 'selected' : '' %>><%= s %></option><% }); %>
          </select>
        </div>
      <% } %>
      <% if (typeof withDates !== 'undefined' && withDates) { %>
        <div class="col-6 col-md-3"><label class="form-label small">From</label><input type="date" name="startDate" class="form-control form-control-sm" value="<%= f.startDate || '' %>"></div>
        <div class="col-6 col-md-3"><label class="form-label small">To</label><input type="date" name="endDate" class="form-control form-control-sm" value="<%= f.endDate || '' %>"></div>
      <% } %>
      <div class="col-12 col-md-2 d-grid">
        <button class="btn btn-ju btn-sm"><i class="bi bi-funnel me-1"></i> Apply</button>
      </div>
    </form>
  </div>
</div>