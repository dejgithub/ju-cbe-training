<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %><%= institutionName %> CBE</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app-shell">
  <%- include('../partials/sidebar') %>
  <div class="sidebar-backdrop"></div>
  <div class="main-area">
    <%- include('../partials/topbar') %>
    <main class="content">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
    <footer class="text-center text-muted small py-3 no-print">
      &copy; <%= new Date().getFullYear() %> <%= institutionName %> &middot; CBE Training Management System
    </footer>
  </div>
</div>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/vendor/chartjs/chart.umd.min.js"></script>
<script src="/js/app.js"></script>
<%- typeof pageScripts !== 'undefined' ? pageScripts : '' %>
</body>
</html>