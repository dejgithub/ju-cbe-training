<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0">Change password</h2>
    <p class="text-muted small mb-0">Choose a strong password with at least 8 characters, including a letter and a number.</p>
  </div>
  <a href="/profile" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<% if (forced) { %>
  <div class="alert alert-warning"><i class="bi bi-shield-exclamation me-1"></i> Your password was reset. Please set a new password to continue securely.</div>
<% } %>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0 small"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
<% } %>

<div class="row">
  <div class="col-lg-6">
    <div class="card">
      <div class="card-body">
        <form method="post" action="/profile/password" class="row g-3" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="col-12">
            <label class="form-label required">Current password</label>
            <input type="password" name="current_password" class="form-control" required autocomplete="current-password">
          </div>
          <div class="col-12">
            <label class="form-label required">New password</label>
            <input type="password" name="new_password" class="form-control" required autocomplete="new-password">
          </div>
          <div class="col-12">
            <label class="form-label required">Confirm new password</label>
            <input type="password" name="confirm_password" class="form-control" required autocomplete="new-password">
          </div>
          <div class="col-12">
            <button class="btn btn-ju"><i class="bi bi-key me-1"></i> Update password</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>