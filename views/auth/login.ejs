<div class="auth-wrapper">
  <div class="card auth-card shadow-lg">
    <div class="auth-brand">
      <img src="/img/ju-logo.jpg" alt="<%= institutionName %> logo" class="auth-logo-img">
      <h1 class="h5 mt-3 mb-0"><%= institutionName %></h1>
      <p class="text-muted mb-0 small">Community-Based Education (CBE) Training Management System</p>
    </div>
    <div class="card-body p-4">
      <% if (error) { %>
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-octagon me-1"></i><%= error %></div>
      <% } %>
      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mb-3">
          <label class="form-label" for="username">Username or Student ID</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-person"></i></span>
            <input type="text" class="form-control" id="username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus autocomplete="username">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
          </div>
        </div>
        <button type="submit" class="btn btn-ju w-100"><i class="bi bi-box-arrow-in-right me-1"></i> Sign in</button>
      </form>
    </div>
    <div class="card-footer bg-light login-hint text-muted">
     <!--<div class="fw-semibold mb-1">Demo accounts (password: <code>Password@123</code>)</div>-->
      <!--admin &middot; coordinator &middot; instructor &middot; student &middot; partner-->
      <div class="mt-2"><a href="/" class="text-ju"><i class="bi bi-arrow-left me-1"></i>Back to home</a></div>
    </div>
  </div>
</div>