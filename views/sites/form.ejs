<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0"><%= isEdit ? 'Edit community site' : 'Register community site' %></h2>
    <p class="text-muted small mb-0">Hospitals, health centers, schools, kebeles, NGOs and government offices.</p>
  </div>
  <a href="/sites" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0 small"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
<% } %>

<div class="card">
  <div class="card-body">
    <form method="post" action="<%= action %>" class="row g-3" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-8">
        <label class="form-label required">Site name</label>
        <input type="text" name="name" class="form-control" value="<%= site.name || '' %>" required maxlength="150">
      </div>
      <div class="col-md-4">
        <label class="form-label">Site type</label>
        <select name="site_type" class="form-select">
          <% siteTypes.forEach(function (t) { %><option value="<%= t %>" <%= site.site_type === t ? 'selected' : '' %>><%= t %></option><% }); %>
        </select>
      </div>
      <div class="col-md-6">
        <label class="form-label">Community partner</label>
        <select name="community_partner_id" class="form-select">
          <option value="">-- None --</option>
          <% partners.forEach(function (p) { %><option value="<%= p.id %>" <%= String(site.community_partner_id) === String(p.id) ? 'selected' : '' %>><%= p.organization_name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">City / Town</label>
        <input type="text" name="city" class="form-control" value="<%= site.city || '' %>" maxlength="100">
      </div>
      <div class="col-md-3">
        <label class="form-label">Available placements</label>
        <input type="number" name="available_placements" class="form-control" value="<%= site.available_placements || 0 %>" min="0">
      </div>
      <div class="col-md-6">
        <label class="form-label">Address</label>
        <input type="text" name="address" class="form-control" value="<%= site.address || '' %>" maxlength="255">
      </div>
      <div class="col-md-6">
        <label class="form-label">Contact person</label>
        <input type="text" name="contact_person" class="form-control" value="<%= site.contact_person || '' %>" maxlength="150">
      </div>
      <div class="col-md-6">
        <label class="form-label">Phone</label>
        <input type="text" name="phone" class="form-control" value="<%= site.phone || '' %>" maxlength="30">
      </div>
      <div class="col-md-6">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" value="<%= site.email || '' %>" maxlength="150">
      </div>
      <div class="col-md-6">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="Active" <%= site.status === 'Active' ? 'selected' : '' %>>Active</option>
          <option value="Inactive" <%= site.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </div>
      <div class="col-12 d-flex gap-2">
        <button class="btn btn-ju"><i class="bi bi-save me-1"></i><%= isEdit ? 'Save changes' : 'Register site' %></button>
        <a href="/sites" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>