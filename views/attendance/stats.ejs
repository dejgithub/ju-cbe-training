<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0">Attendance reports</h2>
    <p class="text-muted small mb-0">Attendance percentage per student for a program over a date range.</p>
  </div>
  <a href="/attendance" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Record attendance</a>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form class="row g-2 align-items-end" method="get" action="/attendance/stats">
      <div class="col-md-5">
        <label class="form-label small">Program</label>
        <select name="program_id" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">-- Select program --</option>
          <% programs.forEach(function (p) { %><option value="<%= p.id %>" <%= String(selectedProgram) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-3"><label class="form-label small">From</label><input type="date" name="start" class="form-control form-control-sm" value="<%= start %>"></div>
      <div class="col-md-3"><label class="form-label small">To</label><input type="date" name="end" class="form-control form-control-sm" value="<%= end %>"></div>
      <div class="col-md-1 d-grid"><button class="btn btn-ju btn-sm"><i class="bi bi-search"></i></button></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <span><i class="bi bi-bar-chart me-1 text-ju"></i> Attendance percentage</span>
    <button class="btn btn-sm btn-outline-secondary" data-export-table="#statsTable" data-filename="attendance_report"><i class="bi bi-download me-1"></i> Export CSV</button>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" id="statsTable" data-sortable>
      <thead>
        <tr><th class="sortable">Student</th><th class="sortable">Student ID</th><th class="sortable text-end">Recorded</th><th class="sortable text-end">Present</th><th class="sortable text-end">Absent</th><th class="sortable text-end">Late</th><th class="sortable text-end">Excused</th><th class="sortable text-end">Attendance %</th></tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %><tr><td colspan="8" class="text-center text-muted py-4">No attendance data for the selected filters.</td></tr><% } %>
        <% rows.forEach(function (r) { %>
          <tr>
            <td class="fw-semibold"><%= r.full_name %></td>
            <td class="font-monospace small"><%= r.reg_no %></td>
            <td class="text-end"><%= r.total_days %></td>
            <td class="text-end text-success"><%= r.present_days %></td>
            <td class="text-end text-danger"><%= r.absent_days %></td>
            <td class="text-end text-warning"><%= r.late_days %></td>
            <td class="text-end text-info"><%= r.excused_days %></td>
            <td class="text-end"><span class="badge <%= Number(r.attendance_percentage) >= 75 ? 'bg-success' : Number(r.attendance_percentage) >= 50 ? 'bg-warning' : 'bg-danger' %>"><%= r.attendance_percentage %>%</span></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>