<%
  const canRecord = currentUser.role === 'Admin' || currentUser.role === 'Coordinator' || currentUser.role === 'Instructor';
%>
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
  <div>
    <h2 class="h5 mb-0">Attendance</h2>
    <p class="text-muted small mb-0">Record and review daily attendance by program.</p>
  </div>
  <% if (canRecord) { %><a href="/attendance/stats" class="btn btn-outline-ju btn-sm"><i class="bi bi-bar-chart me-1"></i> Attendance reports</a><% } %>
</div>

<div class="card mb-3">
  <div class="card-body">
    <form class="row g-2 align-items-end" method="get" action="/attendance">
      <div class="col-md-5">
        <label class="form-label small">Program</label>
        <select name="program_id" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">-- Select program --</option>
          <% programs.forEach(function (p) { %><option value="<%= p.id %>" <%= String(selectedProgram) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small">Date</label>
        <input type="date" name="date" class="form-control form-control-sm" value="<%= date %>">
      </div>
      <div class="col-md-3 d-grid"><button class="btn btn-ju btn-sm"><i class="bi bi-search me-1"></i> Load</button></div>
    </form>
  </div>
</div>

<% if (!selectedProgram) { %>
  <div class="empty-state"><i class="bi bi-calendar-check"></i>Select a program to record attendance.</div>
<% } else { %>
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <span><i class="bi bi-calendar-check me-1 text-ju"></i> Attendance for <%= date %></span>
      <span class="badge bg-secondary"><%= students.length %> students</span>
    </div>
    <form method="post" action="/attendance">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="program_id" value="<%= selectedProgram %>">
      <input type="hidden" name="attendance_date" value="<%= date %>">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr><th>Student</th><th>Student ID</th><th>Group</th><th>Site</th><th style="width:230px">Status</th><th>Remarks</th></tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %><tr><td colspan="6" class="text-center text-muted py-4">No active placements in this program.</td></tr><% } %>
            <% students.forEach(function (s) {
                 const existing = recordByStudent.get(s.id);
                 const current = existing ? existing.status : '';
            %>
              <tr>
                <td class="fw-semibold"><%= s.full_name %></td>
                <td class="font-monospace small"><%= s.student_id %></td>
                <td class="text-muted small"><%= s.group_name || '-' %></td>
                <td class="text-muted small"><%= s.site_name || '-' %></td>
                <td>
                  <div class="btn-group btn-group-sm" role="group">
                    <% statuses.forEach(function (st) { %>
                      <input type="radio" class="btn-check" name="status_<%= s.id %>" id="st_<%= s.id %>_<%= st %>" value="<%= st %>" <%= current === st ? 'checked' : '' %>>
                      <label class="btn btn-outline-<%= st === 'Present' ? 'success' : st === 'Absent' ? 'danger' : st === 'Late' ? 'warning' : 'info' %>" for="st_<%= s.id %>_<%= st %>"><%= st %></label>
                    <% }); %>
                  </div>
                </td>
                <td><input type="text" name="remarks_<%= s.id %>" class="form-control form-control-sm" value="<%= existing && existing.remarks ? existing.remarks : '' %>" placeholder="Optional"></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (students.length > 0) { %>
      <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="notify_absent" id="notify_absent" value="on">
          <label class="form-check-label small" for="notify_absent">Notify students marked absent</label>
        </div>
        <button class="btn btn-ju"><i class="bi bi-save me-1"></i> Save attendance</button>
      </div>
      <% } %>
    </form>
  </div>
<% } %>