<div class="text-center py-5">
  <i class="bi bi-bug text-danger" style="font-size:3.5rem"></i>
  <h1 class="h3 mt-3">Something went wrong</h1>
  <p class="text-muted"><%= typeof message !== 'undefined' && message ? message : 'An unexpected error occurred. Please try again.' %></p>
  <a href="<%= currentUser ? '/dashboard' : '/' %>" class="btn btn-ju"><i class="bi bi-<%= currentUser ? 'speedometer2' : 'house' %> me-1"></i> <%= currentUser ? 'Back to dashboard' : 'Back to home' %></a>
</div>