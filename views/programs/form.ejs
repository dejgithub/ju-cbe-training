<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="h5 mb-0"><%= isEdit ? 'Edit CBE program' : 'Create CBE program' %></h2>
    <p class="text-muted small mb-0">Define the program, its objectives, dates and coordinators.</p>
  </div>
  <a href="/programs" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<% if (errors && errors.length) { %>
  <div class="alert alert-danger"><ul class="mb-0 small"><% errors.forEach(function (e) { %><li><%= e %></li><% }); %></ul></div>
<% } %>

<div class="card">
  <div class="card-body">
    <form method="post" action="<%= action %>" class="row g-3" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-8">
        <label class="form-label required">Program name</label>
        <input type="text" name="name" class="form-control" value="<%= program.name || '' %>" required maxlength="200">
      </div>
      <div class="col-md-4">
        <label class="form-label required">Program code</label>
        <input type="text" name="code" class="form-control" value="<%= program.code || '' %>" required maxlength="30" placeholder="e.g. CBE-PH-2025">
      </div>
      <div class="col-12">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="2" maxlength="5000"><%= program.description || '' %></textarea>
      </div>
      <div class="col-md-6">
        <label class="form-label">Objectives</label>
        <textarea name="objectives" class="form-control" rows="3" maxlength="5000"><%= program.objectives || '' %></textarea>
      </div>
      <div class="col-md-6">
        <label class="form-label">Expected learning outcomes</label>
        <textarea name="learning_outcomes" class="form-control" rows="3" maxlength="5000"><%= program.learning_outcomes || '' %></textarea>
      </div>

      <div class="col-md-4">
        <label class="form-label">Department</label>
        <select name="department_id" class="form-select">
          <option value="">-- Select --</option>
          <% departments.forEach(function (d) { %><option value="<%= d.id %>" <%= String(program.department_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Coordinator</label>
        <select name="coordinator_user_id" class="form-select">
          <option value="">-- Select --</option>
          <% coordinators.forEach(function (c) { %><option value="<%= c.id %>" <%= String(program.coordinator_user_id) === String(c.id) ? 'selected' : '' %>><%= c.full_name %></option><% }); %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Academic year</label>
        <select name="academic_year_id" class="form-select">
          <option value="">-- Select --</option>
          <% years.forEach(function (y) { %><option value="<%= y.id %>" <%= String(program.academic_year_id) === String(y.id) ? 'selected' : '' %>><%= y.name %></option><% }); %>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label">Start date</label>
        <input type="date" name="start_date" class="form-control" value="<%= program.start_date || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">End date</label>
        <input type="date" name="end_date" class="form-control" value="<%= program.end_date || '' %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">Location</label>
        <input type="text" name="location" class="form-control" value="<%= program.location || '' %>" maxlength="200">
      </div>
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <% statuses.forEach(function (s) { %><option value="<%= s %>" <%= program.status === s ? 'selected' : '' %>><%= s %></option><% }); %>
        </select>
      </div>

      <% if (!isEdit) { %>
        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="notify" id="notify" value="1">
            <label class="form-check-label small" for="notify">Notify students about this new program</label>
          </div>
        </div>
      <% } %>

      <div class="col-12 d-flex gap-2">
        <button class="btn btn-ju"><i class="bi bi-save me-1"></i><%= isEdit ? 'Save changes' : 'Create program' %></button>
        <a href="/programs" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>